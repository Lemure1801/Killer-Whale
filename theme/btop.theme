# KillerWhale phosphorescent cyan theme for btop
# Matching central palette: #000000 (bg), #00ffd1 (fg), #4dffef (hi), #00b398 (accent), #ff3355 (alert)

theme[main_bg]="#000000"
theme[main_fg]="#00ffd1"
theme[title]="#4dffef"
theme[hi_fg]="#ffffff"
theme[selected_bg]="#00332b"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#00594d"
theme[proc_misc]="#00ffd1"

# Box borders and dividers
theme[cpu_box]="#008b7a"
theme[mem_box]="#008b7a"
theme[net_box]="#008b7a"
theme[proc_box]="#008b7a"
theme[div_line]="#00332b"

# Meters and graphs (Phosphor cyan gradient to amber to red)
theme[temp_start]="#00ffd1"
theme[temp_mid]="#00b398"
theme[temp_end]="#ff3355"

theme[cpu_start]="#00594d"
theme[cpu_mid]="#00ffd1"
theme[cpu_end]="#4dffef"

theme[free]="#002620"
theme[cached]="#00594d"
theme[available]="#008b7a"
theme[used]="#00ffd1"

theme[download_start]="#00594d"
theme[download_mid]="#00ffd1"
theme[download_end]="#4dffef"

theme[upload_start]="#00332b"
theme[upload_mid]="#00ffd1"
theme[upload_end]="#00b398"

