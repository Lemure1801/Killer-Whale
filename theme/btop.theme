# KillerWhale phosphor green theme for btop
# Matching central palette: #050a05 (bg), #00ff66 (fg), #ffb000 (accent), #ff3333 (alert)

theme[main_bg]="#050a05"
theme[main_fg]="#00ff66"
theme[title]="#66ff99"
theme[hi_fg]="#ffffff"
theme[selected_bg]="#003311"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#006622"
theme[proc_misc]="#00cc52"

# Box borders and dividers
theme[cpu_box]="#009933"
theme[mem_box]="#009933"
theme[net_box]="#009933"
theme[proc_box]="#009933"
theme[div_line]="#004d1a"

# Meters and graphs (Phosphor green gradient to amber to red)
theme[temp_start]="#00cc52"
theme[temp_mid]="#ffb000"
theme[temp_end]="#ff3333"

theme[cpu_start]="#00aa33"
theme[cpu_mid]="#00ff66"
theme[cpu_end]="#ffb000"

theme[free]="#004d1a"
theme[cached]="#00802b"
theme[available]="#00b33c"
theme[used]="#00ff66"

theme[download_start]="#00802b"
theme[download_mid]="#00ff66"
theme[download_end]="#66ff99"

theme[upload_start]="#006622"
theme[upload_mid]="#00cc52"
theme[upload_end]="#ffb000"
